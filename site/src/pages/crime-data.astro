---
import Base from '../layouts/Base.astro';
import { Content as Essay } from '../content/crime-data.md';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Crime Data as a Subject for an As-if Science Jam"
      description="Walter Fuchs on why crime is the right subject for the jam: myths, dark figures, and correlations that are apparent rather than actual.">
  <a href={`${base}/`} class="font-mono text-[12px] text-muted no-underline hover:text-accent">← the jam</a>
  <h1 class="mt-3 max-w-[22ch] text-[clamp(1.9rem,4.4vw,2.9rem)] font-semibold leading-tight tracking-[-.022em]">
    Crime Data as a Subject for an “As-if Science Jam”
  </h1>
  <p class="mt-3 font-mono text-[13px] text-muted">
    Walter Fuchs · Professor of Criminology, Berlin School of Economics and Law
  </p>
  <article class="prose mt-9"><Essay /></article>
  <p class="prose mt-10 border-t border-line pt-6 font-mono text-[12px] text-faint">
    The dataset this essay argues for is <a href={`${base}/datasets/murder-inequality-46-countries`}>homicide and inequality
    across 46 countries</a>, worked through in the <a href={`${base}/murder`}>murder example</a>.
  </p>
</Base>
