---
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const docs = Object.entries(import.meta.glob('../../../../datasets/*.md', { eager: true }));
  return docs.map(([path, mod]) => {
    const slug = path.split('/').pop().replace(/\.md$/, '');
    const raw = mod.rawContent ? mod.rawContent() : '';
    return { params: { slug }, props: { Content: mod.Content, title: (raw.match(/^#\s+(.+)$/m)?.[1] ?? slug).replace(/`/g, '') } };
  });
}
const { Content, title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={`${title} — As-If Science Jam`}>
  <a href={`${base}/datasets`} class="font-mono text-[12px] text-muted no-underline hover:text-accent">← all datasets</a>
  <article class="prose mt-2"><Content /></article>
</Base>
