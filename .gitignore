# Built by bin/setup, never vendored.
bin/cockpit
bin/plankton
bin/nekton
bin/kton

# Your PRIVATE signing key. Anyone who can read it can sign as you.
keys/*.key

# Written by bin/setup and deliberately NOT shared: it names which identity signs here, and that
# differs per person. Everything in it that IS shared — the trust tier, the image, the paths —
# comes from cockpit.config.shared.json, which is committed.
cockpit.config.json

.Rproj.user
.Rhistory

# the site
site/node_modules/
site/.astro/

# 53 MB, and a LIVE register: two fetches are not the same file. The chain records its hash,
# and 01-trees.R falls back to data/wien-baumkataster.csv.gz when it is absent.
examples/trees-and-culture/inputs/baumkataster.csv

# macOS leaves these in every folder it has ever opened.
.DS_Store
